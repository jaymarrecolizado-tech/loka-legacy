# Plan #43 SSO service — copy to .env and fill in. NEVER commit .env.
SSO_DB_DSN=mysql+pymysql://sso_user:CHANGE_ME@127.0.0.1:3306/sso_prod
SSO_BASE_URL=https://sso.dictr2.cloud
SSO_ISSUER=https://sso.dictr2.cloud
# 64+ random hex chars: openssl rand -hex 32 (HMAC-signs session cookies)
SSO_APP_SECRET=CHANGE_ME
SSO_KEYS_DIR=./keys
SSO_LOCKOUT_THRESHOLD=5
SSO_LOCKOUT_WINDOW=15
SSO_LOCKOUT_MINUTES=15
